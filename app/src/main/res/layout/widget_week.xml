<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/week_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F3"
    android:orientation="vertical"
    android:padding="10dp">
    <TextView android:id="@+id/week_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#332A27" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/week_widget_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="8" android:textColor="#443A36" android:textSize="11sp" />
</LinearLayout>
