<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher-hosted RemoteViews do not draw the app theme window background. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="Overdraw"
    android:id="@+id/todo_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F3"
    android:orientation="vertical"
    android:padding="10dp">
    <TextView
        android:id="@+id/todo_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#332A27"
        android:textSize="15sp"
        android:textStyle="bold" />
    <ListView
        android:id="@+id/todo_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="1dp"
        android:scrollbars="vertical" />
</LinearLayout>
