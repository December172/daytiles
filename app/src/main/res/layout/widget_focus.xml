<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F3"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView android:id="@+id/focus_widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#332A27" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/focus_widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#443A36" android:textSize="22sp" />
    <Button android:id="@+id/focus_widget_start" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/focus_start" />
</LinearLayout>
