<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/journal_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F3"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/journal_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#332A27"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/journal_widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#8A7E79"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/journal_widget_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="top"
        android:maxLines="4"
        android:textColor="#443A36"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/journal_widget_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingTop="6dp"
        android:text="@string/journal_widget_edit"
        android:textColor="#F47721"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
